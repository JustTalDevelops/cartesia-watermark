# Secrets: API key and proxy credentials live only here (see .env.example)
.env
.env.*
!.env.example

# Python environment / caches
.venv/
__pycache__/
.cache/

# Generated audio (regenerate with tools/corpus*.py). Keep only the voice/text plans so the exact voices,
# sentences and train/validation/sealed splits are reproducible.
audio/**
!audio/**/
!audio/corpus3/voices.json
!audio/corpus4/voices.json
!audio/sealed/voices.json
!audio/corpus5_plan.json
!audio/corpus6_plan.json
!audio/corpus7_plan.json
!audio/reconstruction_reliability_plan.json
!audio/vocoder_reliability_plan.json
!audio/filtered_prior_reliability_plan.json

# Extracted SSL features (tools/frames.py, tools/frames_contrast.py), ~20 GB
features/
features_*/

# Results: only what the documentation cites (Cartesia labels, detector configs, per-clip scores) and the
# round-4 detector heads. Intermediate checkpoints, arrays and raw logs stay local.
results/*
!results/align.json
!results/mechanism.json
!results/phase2.json
!results/detect_cache.json
!results/distill.json
!results/eval_*.txt
!results/*validate*.txt
!results/sealed_eval.txt
!results/val_label_order.txt
!results/val_cartesia.json
!results/val_scores_*.json
!results/wavlm_detector2_config.json
!results/final_detector_r2.json
!results/final_detector_r3.json
!results/final_detector_r3_val_members.json
!results/final_detector_r4.json
!results/final_detector_r4_val_members.json
!results/final_val_members.json
!results/sealed_scores.json
!results/sealed[234]_cartesia.json
!results/sealed[234]_final.json
!results/h2h4_cartesia.json
!results/h2h4_final.json
!results/head_conv_heldout_x4c[012].pt
!results/README.md
!results/reconstruction_runtime.json
!results/reconstruction_local_shift.json
!results/reconstruction_reliability.json
!results/reconstruction_vocoder.json
!results/reconstruction_vocoder_runtime.json
!results/reconstruction_verification.json
!results/reconstruction_filtered_prior.json
!results/model_catalog.json

