# Copy to .env (gitignored). Only needed for generating audio and calling Cartesia's detector;
# local detection (tools/detect_local.py) needs neither.
CARTESIA_API_KEY=sk_car_your_key_here

# Optional: route /v1/watermark/detect through ONE sticky proxy session (the endpoint is rate-limited per IP).
# Calls are paced by DETECT_INTERVAL (seconds); the run stops if the proxy's egress IP changes.
# DETECT_PROXY=http://user:pass@proxy.example.com:1000
# DETECT_INTERVAL=40
